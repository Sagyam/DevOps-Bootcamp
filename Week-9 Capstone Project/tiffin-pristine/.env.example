# Copy to .env for local development. Never commit .env.
# Real values come from AWS Secrets Manager (prod) via External Secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

PGHOST=localhost
PGPORT=5432
PGDATABASE=tiffin
PGUSER=tiffin
PGPASSWORD=change-me-locally

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=tiffin-api
