      "description": "A rough estimate: about 9 spans per request after the instrumentation curation in tracing.ts. Before curation it was 21. Multiply by your traffic and by ~1KB per span to see why sampling exists.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
