    {
      "id": 12,
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "title": "Spans exported / sec (rate of tracing cost)",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 26
