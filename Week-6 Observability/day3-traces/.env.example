# Copy this file to .env (docker compose loads .env automatically) and fill
# in your own values. .env is gitignored -- your API key never gets committed.
#
#   cp .env.example .env

# Resend dashboard -> API Keys -> Create API Key. Used as the SMTP password
# for Grafana's alert emails. https://resend.com/docs/send-with-smtp
RESEND_API_KEY=

# Optional. Only needed if you verified your own domain in Resend -- until
# then, alerts send from onboarding@resend.dev (the default, no setup needed).
ALERT_FROM_ADDRESS=

# The inbox that should receive alert emails. This one is NOT read by
# docker-compose -- it isn't wired to an env var (see the note in
# grafana/provisioning/alerting/contact-points.yaml for why). Edit that file
# directly and replace CHANGE_ME@example.com with this same address.
ALERT_TO_EMAIL=
