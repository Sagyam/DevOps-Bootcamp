# ---------------------------------------------------------------------------
# STEP 2 of Lab 01.
# Rename this file to backend.tf, paste in your state bucket name,
# then run:  terraform init -migrate-state
#
# NOTE: a backend block CANNOT use variables, locals, or any interpolation.
# It is read before Terraform evaluates anything else. That is why you either
# hardcode it (like here) or use partial config:
#     terraform init -backend-config="bucket=my-bucket"
# ---------------------------------------------------------------------------
terraform {
  backend "s3" {
    bucket = "PASTE-YOUR-STATE-BUCKET-NAME-HERE"
    key    = "lab01-s3/terraform.tfstate"
    region = "ap-south-1"

    encrypt = true

    # Native S3 state locking. Needs Terraform >= 1.11.
    # On older versions delete this line (or use the legacy dynamodb_table arg).
    use_lockfile = true
  }
}
